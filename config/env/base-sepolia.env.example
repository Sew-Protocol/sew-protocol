# Base Sepolia Testnet Configuration
# Copy to .env.base-sepolia.local and fill in values
# Never commit secrets to git

# Deployment Account
DEPLOYER_PRIVATE_KEY=

# RPC Configuration
RPC_URL=https://sepolia.base.org

# Chain Configuration
NETWORK=baseSepolia
CHAIN_ID=84532

# Contract Addresses (for integration testing)
ESCROW_VAULT_ADDRESS=0x13b8b7572c72b46879662BFEA53851cBeD3bC47a
AAVE_YIELD_MODULE_ADDRESS=0x084DD3BA96B14Ce07746E7c6AF23454dcbB65C01
SEW_TOKEN_ADDRESS=0x79913fCa36Ea4e747F4742a4c1C7bC93a1522a14

# Test Accounts (for integration tests)
TEST_SELLER_PRIVATE_KEY=
TEST_BUYER_PRIVATE_KEY=
TEST_ADMIN_PRIVATE_KEY=
TEST_RESOLVER_PRIVATE_KEY=

# Verification (optional)
BASESCAN_API_KEY=

# Test Configuration
TEST_DELAY_SECONDS=4
TEST_POLL_SECONDS=10
TEST_RUN_NEGATIVE_TXS=0
TEST_WAIT_FOR_APPEAL_WINDOW=0
