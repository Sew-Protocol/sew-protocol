    }
    
    function test_withdrawFeesBatch_revertsIfNotFeeAddress() public {
        address[] memory tokens = new address[](1);
        tokens[0] = address(token1);
        
        vm.prank(buyer);
        vm.expectRevert();
        vault.withdrawFeesBatch(tokens);
    }
    */
    
    function test_getTokenInfo() public {
        uint256 amount = 1000e18;
        token1.mint(buyer, amount);
        vm.prank(buyer);
        token1.approve(address(vault), amount);
        
        vm.prank(buyer);
        vault.createEscrow(address(token1), seller, amount, vault.getDefaultSettings());
        
        uint256 balance = vault.totalHeldInEscrowPerToken(address(token1));
        uint256 fees = vault.totalFeesPerToken(address(token1));
        assertGt(balance, 0);
        assertGt(fees, 0);
    }
    
    // ============ Recovery ============
    
    function test_recoverERC20() public {
        uint256 amount = 1000e18;
        token1.mint(address(vault), amount);
        
        uint256 balanceBefore = token1.balanceOf(seller);
        vm.prank(timelock);
        vault.recoverERC20(address(token1), seller, amount);
        uint256 balanceAfter = token1.balanceOf(seller);
        
        assertEq(balanceAfter - balanceBefore, amount);
    }
    
    function test_recoverERC20_revertsIfNotTimelock() public {
        vm.prank(buyer);
        vm.expectRevert();
        vault.recoverERC20(address(token1), seller, 1000e18);
    }
}

