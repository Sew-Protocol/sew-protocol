// SPDX-License-Identifier: UNLICENSED
pragma solidity 0.8.33;

import "forge-std/Test.sol";
import "../../../contracts/core/EscrowVault.sol";
import "../../../contracts/core/EscrowableERC20.sol";
import "../../../contracts/mocks/ERC20Mock.sol";

// Note: ERC20Mock constructor signature may differ - adjust if needed
import "../../../contracts/core/modules/DefaultResolutionModule.sol";
import "../../../contracts/modules/DefaultReleaseStrategy.sol";
import "../../../contracts/modules/DefaultYieldModule.sol";
import "../../../contracts/modules/DefaultYieldDistributionModule.sol";
import "../../../contracts/types/EscrowTypes.sol";


/**
 * @title EscrowHandler
 * @notice Handler contract for invariant testing
 * @dev Performs various actions on escrow contracts to test invariants
 */
contract EscrowHandler is Test {
    EscrowVault public vault;
    EscrowableERC20 public escrowableERC20;
    ERC20Mock public token;
    
    // Track state for invariants
    mapping(uint256 => bool) public escrowsCreated;
    mapping(uint256 => bool) public escrowsReleased;
    mapping(uint256 => bool) public escrowsCancelled;
    mapping(uint256 => bool) public escrowsDisputed;
    
    uint256 public totalEscrowsCreated = 0;
    uint256 public totalEscrowsReleased = 0;
    uint256 public totalEscrowsCancelled = 0;
    uint256 public totalEscrowsDisputed = 0;
    
    address[] public users;
    address public feeAddress;
    address public resolver;
    
    // Module addresses
    DefaultResolutionModule public resolutionModule;
    DefaultReleaseStrategy public releaseStrategy;
    DefaultYieldModule public yieldModule;
    DefaultYieldDistributionModule public yieldDistributionModule;
    
    constructor(
        EscrowVault _vault,
        EscrowableERC20 _escrowableERC20,
        ERC20Mock _token,
        address _feeAddress,
        address _resolver
    ) Test() {
        vault = _vault;
        escrowableERC20 = _escrowableERC20;
        token = _token;
        feeAddress = _feeAddress;
        resolver = _resolver;
        
        // Note: Module setup is handled by EscrowInvariants.setUp()
        // Handler assumes modules are already configured
        
        // Create test users
        for (uint256 i = 0; i < 10; i++) {
            address user = address(uint160(0x1000 + i));
            users.push(user);
            
            // Mint ERC20Mock tokens to users
            token.mint(user, 1000000e18);
            
            // Approve contracts
            vm.prank(user);
            token.approve(address(vault), type(uint256).max);
            vm.prank(user);
            escrowableERC20.approve(address(escrowableERC20), type(uint256).max);
        }
        
        // Note: escrowableERC20 tokens will be transferred to users by EscrowInvariants.setUp()
        // Handler doesn't have escrowableERC20 tokens to transfer in constructor
    }
    
    function createEscrowVault(uint256 amount, uint256 userIndex) external {
        if (userIndex >= users.length) return;
        if (amount == 0) return;
        
        amount = bound(amount, 1, 10000e18);
        address user = users[userIndex % users.length];
        address seller = users[(userIndex + 1) % users.length];
        
        if (token.balanceOf(user) < amount) return;
        
        vm.prank(user);
        try vault.createEscrow(address(token), seller, amount) returns (uint256 workflowId) {
            escrowsCreated[workflowId] = true;
            totalEscrowsCreated++;
        } catch {}
    }
    
    function createEscrowERC20(uint256 amount, uint256 userIndex) external {
        if (userIndex >= users.length) return;
        if (amount == 0) return;
        
        amount = bound(amount, 1, 10000e18);
        address user = users[userIndex % users.length];
        address seller = users[(userIndex + 1) % users.length];
        
        if (escrowableERC20.balanceOf(user) < amount) return;
        
        vm.prank(user);
        try escrowableERC20.createEscrow(seller, amount) returns (uint256 workflowId) {
            escrowsCreated[workflowId] = true;
            totalEscrowsCreated++;
        } catch {}
    }
    
    function releaseEscrowVault(uint256 workflowId) external {
        if (!escrowsCreated[workflowId]) return;
        if (escrowsReleased[workflowId] || escrowsCancelled[workflowId]) return;
        
        // getEscrowTransfer returns EscrowTransfer (from EscrowTypes)
        // BaseEscrow uses EscrowTransfer directly, so we use it the same way
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
            if (et.escrowState != EscrowState.PENDING) return;
        
        vm.prank(et.from);
        try vault.releaseEscrowTransfer(workflowId) {
            escrowsReleased[workflowId] = true;
            totalEscrowsReleased++;
        } catch {}
    }
    
    function releaseEscrowERC20(uint256 workflowId) external {
        if (!escrowsCreated[workflowId]) return;
        if (escrowsReleased[workflowId] || escrowsCancelled[workflowId]) return;
        
        EscrowTransfer memory et = escrowableERC20.getEscrowTransfer(workflowId);
            if (et.escrowState != EscrowState.PENDING) return;
        
        vm.prank(et.from);
        try escrowableERC20.releaseEscrowTransfer(workflowId) {
            escrowsReleased[workflowId] = true;
            totalEscrowsReleased++;
        } catch {}
    }
    
    function cancelEscrowVault(uint256 workflowId) external {
        if (!escrowsCreated[workflowId]) return;
        if (escrowsReleased[workflowId] || escrowsCancelled[workflowId]) return;
        
        // getEscrowTransfer returns EscrowTransfer (from EscrowTypes)
        // BaseEscrow uses EscrowTransfer directly, so we use it the same way
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
            if (et.escrowState != EscrowState.PENDING) return;
        
        // Try sender cancel
        vm.prank(et.from);
        try vault.senderCancel(workflowId) {
            if (et.recipientStatus == RecipientStatus.AGREE_TO_CANCEL) {
                escrowsCancelled[workflowId] = true;
                totalEscrowsCancelled++;
            }
        } catch {}
        
        // Try recipient cancel
        vm.prank(et.to);
        try vault.recipientCancel(workflowId) {
            if (et.senderStatus == SenderStatus.AGREE_TO_CANCEL) {
                escrowsCancelled[workflowId] = true;
                totalEscrowsCancelled++;
            }
        } catch {}
    }
    
    function cancelEscrowERC20(uint256 workflowId) external {
        if (!escrowsCreated[workflowId]) return;
        if (escrowsReleased[workflowId] || escrowsCancelled[workflowId]) return;
        
        EscrowTransfer memory et = escrowableERC20.getEscrowTransfer(workflowId);
            if (et.escrowState != EscrowState.PENDING) return;
        
        // Try sender cancel
        vm.prank(et.from);
        try escrowableERC20.senderCancel(workflowId) {
            if (et.recipientStatus == RecipientStatus.AGREE_TO_CANCEL) {
                escrowsCancelled[workflowId] = true;
                totalEscrowsCancelled++;
            }
        } catch {}
        
        // Try recipient cancel
        vm.prank(et.to);
        try escrowableERC20.recipientCancel(workflowId) {
            if (et.senderStatus == SenderStatus.AGREE_TO_CANCEL) {
                escrowsCancelled[workflowId] = true;
                totalEscrowsCancelled++;
            }
        } catch {}
    }
    
    function raiseDisputeVault(uint256 workflowId) external {
        if (!escrowsCreated[workflowId]) return;
        if (escrowsReleased[workflowId] || escrowsCancelled[workflowId] || escrowsDisputed[workflowId]) return;
        
        // getEscrowTransfer returns EscrowTransfer (from EscrowTypes)
        // BaseEscrow uses EscrowTransfer directly, so we use it the same way
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
            if (et.escrowState != EscrowState.PENDING) return;
        
        // Try sender dispute
        vm.prank(et.from);
        try vault.raiseDispute(workflowId) {
            escrowsDisputed[workflowId] = true;
            totalEscrowsDisputed++;
        } catch {}
        
        // Try recipient dispute
        vm.prank(et.to);
        try vault.raiseDispute(workflowId) {
            escrowsDisputed[workflowId] = true;
            totalEscrowsDisputed++;
        } catch {}
    }
    
    function raiseDisputeERC20(uint256 workflowId) external {
        if (!escrowsCreated[workflowId]) return;
        if (escrowsReleased[workflowId] || escrowsCancelled[workflowId] || escrowsDisputed[workflowId]) return;
        
        EscrowTransfer memory et = escrowableERC20.getEscrowTransfer(workflowId);
            if (et.escrowState != EscrowState.PENDING) return;
        
        // Try sender dispute
        vm.prank(et.from);
        try escrowableERC20.raiseDispute(workflowId) {
            escrowsDisputed[workflowId] = true;
            totalEscrowsDisputed++;
        } catch {}
        
        // Try recipient dispute
        vm.prank(et.to);
        try escrowableERC20.raiseDispute(workflowId) {
            escrowsDisputed[workflowId] = true;
            totalEscrowsDisputed++;
        } catch {}
    }
    
    function resolveDisputeVault(uint256 workflowId) external {
        if (!escrowsDisputed[workflowId]) return;
        
        // getEscrowTransfer returns EscrowTransfer (from EscrowTypes)
        // BaseEscrow uses EscrowTransfer directly, so we use it the same way
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
        if (et.escrowState != EscrowState.DISPUTED) return;
        
        vm.prank(resolver);
        try vault.releaseAsDisputeResolver(workflowId) {
            escrowsReleased[workflowId] = true;
            totalEscrowsReleased++;
        } catch {
            try vault.cancelAsDisputeResolver(workflowId) {
                escrowsCancelled[workflowId] = true;
                totalEscrowsCancelled++;
            } catch {}
        }
    }
    
    function resolveDisputeERC20(uint256 workflowId) external {
        if (!escrowsDisputed[workflowId]) return;
        
        EscrowTransfer memory et = escrowableERC20.getEscrowTransfer(workflowId);
        if (et.escrowState != EscrowState.DISPUTED) return;
        
        vm.prank(resolver);
        try escrowableERC20.releaseAsDisputeResolver(workflowId) {
            escrowsReleased[workflowId] = true;
            totalEscrowsReleased++;
        } catch {
            try escrowableERC20.cancelAsDisputeResolver(workflowId) {
                escrowsCancelled[workflowId] = true;
                totalEscrowsCancelled++;
            } catch {}
        }
    }
    
    function automateTimedActionsVault(uint256 startId, uint256 rangeEnd) external {
        startId = bound(startId, 0, vault.getEscrowCount());
        rangeEnd = bound(rangeEnd, startId, startId + 100);
        
        try vault.automateTimedActions(startId) {} catch {}
    }
    
    function automateTimedActionsERC20(uint256 startId, uint256 rangeEnd) external {
        startId = bound(startId, 0, escrowableERC20.getEscrowCount());
        rangeEnd = bound(rangeEnd, startId, startId + 100);
        
        try escrowableERC20.automateTimedActions(startId) {} catch {}
    }
}

