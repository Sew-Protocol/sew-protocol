// SPDX-License-Identifier: UNLICENSED
pragma solidity ^0.8.33;

import "forge-std/Test.sol";
import {EscrowableERC20} from "../../../contracts/core/EscrowableERC20.sol";
import {EscrowVault} from "../../../contracts/core/EscrowVault.sol";
import {ERC20Mock} from "../../../contracts/mocks/ERC20Mock.sol";
import {DefaultResolutionModule} from "../../../contracts/core/modules/DefaultResolutionModule.sol";
import {EscrowState} from "../../../contracts/types/EscrowTypes.sol";

/**
 * @title BaseEscrowSecuritySimple
 * @notice Core security tests for BaseEscrow focusing on critical security properties
 */
contract BaseEscrowSecuritySimple is Test {
    EscrowableERC20 token;
    ERC20Mock paymentToken;
    DefaultResolutionModule resolutionModule;
    
    address owner = address(this);  // Test contract is owner
    address sender = address(0x2);
    address recipient = address(0x3);
    address resolver = address(0x4);
    address feeRecipient = address(0x5);
    address attacker = address(0x6);
    
    uint256 constant ESCROW_FEE = 100; // 1%
    uint256 constant AMOUNT = 1 ether;
    
    bytes32 ROLE_TIMELOCK;
    
    function setUp() public {
        // Deploy contracts
        token = new EscrowableERC20("Test Token", "TEST", ESCROW_FEE, feeRecipient, address(0), address(0));
        
        // Get roles
        ROLE_TIMELOCK = token.ROLE_TIMELOCK();
        
        // Setup roles
        token.grantRole(ROLE_TIMELOCK, owner);
        
        // Deploy and setup resolution module
        resolutionModule = new DefaultResolutionModule(owner, resolver);
        
        token.queueDefaultResolutionModule(address(resolutionModule));
        vm.warp(block.timestamp + 14 days + 1);
        token.activateDefaultResolutionModule();
        
        // Distribute tokens
        token.transfer(sender, 100 ether);
        token.transfer(attacker, 100 ether);
        
        // Approve spending
        vm.prank(sender);
        token.approve(address(token), type(uint256).max);
        
        vm.prank(attacker);
        token.approve(address(token), type(uint256).max);
    }
    
    // =========================================================================
    // Reentrancy Protection Tests
    // =========================================================================
    
    function test_Security_nonReentrantOnRelease() public {
        // Create escrow
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        uint256 workflowId = token.nextWorkflowId() - 1;
        
        // Release should complete successfully (nonReentrant modifier protects)
        vm.prank(sender);
        bool success = token.releaseEscrowTransfer(workflowId);
        assertTrue(success, "Release should succeed");
    }
    
    function test_Security_nonReentrantOnDispute() public {
        // Create escrow
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        uint256 workflowId = token.nextWorkflowId() - 1;
        
        // Raise dispute should complete successfully
        vm.prank(sender);
        bool success = token.raiseDispute(workflowId);
        assertTrue(success, "Dispute should be raised");
    }
    
    // =========================================================================
    // Integer Overflow/Underflow Tests  
    // =========================================================================
    
    function test_Revert_Security_rejectZeroAmounts() public {
        // Zero amount should revert
        vm.prank(sender);
        vm.expectRevert();
        token.createEscrow(recipient, 0);
    }
    
    function test_Security_handleLargeAmounts() public {
        // Give sender a large amount
        uint256 largeAmount = 50 ether;
        
        // Should handle large amounts successfully
        vm.prank(sender);
        uint256 workflowId = token.createEscrow(recipient, largeAmount);
        assertTrue(workflowId == 0, "Should create first escrow with ID 0");
    }
    
    function test_Security_balanceNeverUnderflows() public {
        // Create escrow
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        
        // Balance should never underflow
        uint256 balance = token.balanceOf(sender);
        assertGe(balance, 0, "Balance should never underflow");
    }
    
    // =========================================================================
    // Access Control Bypass Tests
    // =========================================================================
    
    function test_Revert_Security_nonSenderCannotRelease() public {
        // Create escrow
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        uint256 workflowId = token.nextWorkflowId() - 1;
        
        // Attacker tries to release - should fail
        vm.prank(attacker);
        vm.expectRevert();
        token.releaseEscrowTransfer(workflowId);
    }
    
    function test_Revert_Security_nonParticipantCannotRaiseDispute() public {
        // Create escrow
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        uint256 workflowId = token.nextWorkflowId() - 1;
        
        // Attacker tries to raise dispute - should fail
        vm.prank(attacker);
        vm.expectRevert();
        token.raiseDispute(workflowId);
    }
    
    
    // =========================================================================
    // State Machine Violation Tests
    // =========================================================================
    
    function test_Revert_Security_cannotReleaseNonPendingEscrow() public {
        // Create and release escrow
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        uint256 workflowId = token.nextWorkflowId() - 1;
        
        vm.prank(sender);
        token.releaseEscrowTransfer(workflowId);
        
        // Try to release again - should fail
        vm.expectRevert();
        vm.prank(sender);
        token.releaseEscrowTransfer(workflowId);
    }
    
    function test_Revert_Security_cannotDisputeReleasedEscrow() public {
        // Create and release escrow
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        uint256 workflowId = token.nextWorkflowId() - 1;
        
        vm.prank(sender);
        token.releaseEscrowTransfer(workflowId);
        
        // Try to dispute released escrow - should fail
        vm.expectRevert();
        vm.prank(sender);
        token.raiseDispute(workflowId);
    }
    
    // =========================================================================
    // Invalid Workflow ID Tests
    // =========================================================================
    
    function test_Revert_Security_rejectNonExistentWorkflowId() public {
        uint256 nonExistentId = 999;
        
        // Should fail with non-existent ID
        vm.prank(sender);
        vm.expectRevert();
        token.releaseEscrowTransfer(nonExistentId);
    }
    
    function test_Revert_Security_rejectFutureWorkflowId() public {
        uint256 nextId = token.nextWorkflowId();
        
        // Should fail with future ID
        vm.expectRevert();
        vm.prank(sender);
        token.releaseEscrowTransfer(nextId);
    }
    
    // =========================================================================
    // Time-Based Operation Tests
    // =========================================================================
    
    function test_Security_respectTimelockDelays() public {
        // Queue new fee recipient
        vm.prank(owner);
        token.queueEscrowFeeAddress(address(0x7777));
        
        // Try to activate immediately - should fail
        vm.prank(owner);
        vm.expectRevert();
        token.activateEscrowFeeAddress();
        
        // Fast forward past delay
        vm.warp(block.timestamp + 7 days + 1);
        
        // Now activation should work
        vm.prank(owner);
        token.activateEscrowFeeAddress();
        
        // Verify change took effect
    }
    
    function test_Revert_Security_cannotBypassTimelockDelay() public {
        // Queue new fee
        vm.prank(owner);
        token.queueEscrowFeeAddress(address(0x8888));
        
        // Try to activate too early (1 day)
        vm.warp(block.timestamp + 1 days);
        vm.prank(owner);
        vm.expectRevert();
        token.activateEscrowFeeAddress(); // Should fail
    }
    
    // =========================================================================
    // Fee Calculation Edge Cases
    // =========================================================================
    
    function test_Security_handleMaxFee() public {
        // Create new token with max fee (100%)
        EscrowableERC20 maxFeeToken = new EscrowableERC20("Max Fee", "MAX", 10000, feeRecipient, address(0), address(0));
        
        // Setup
        maxFeeToken.grantRole(ROLE_TIMELOCK, owner);
        
        maxFeeToken.queueDefaultResolutionModule(address(resolutionModule));
        vm.warp(block.timestamp + 14 days + 1);
        maxFeeToken.activateDefaultResolutionModule();
        
        // Transfer and create escrow
        maxFeeToken.transfer(sender, 10 ether);
        vm.prank(sender);
        maxFeeToken.approve(address(maxFeeToken), type(uint256).max);
        
        // Should handle 100% fee
        vm.prank(sender);
        uint256 workflowId = maxFeeToken.createEscrow(recipient, 1 ether);
        assertEq(workflowId, 0, "Should create escrow with max fee");
    }
    
    function test_Security_feeRoundingConsistency() public {
        // Test that fee rounding is consistent
        uint256[] memory amounts = new uint256[](3);
        amounts[0] = 1 ether;
        amounts[1] = 1.5 ether;
        amounts[2] = 2.33 ether;
        
        for (uint256 i = 0; i < amounts.length; i++) {
            vm.prank(sender);
            uint256 workflowId = token.createEscrow(recipient, amounts[i]);
            assertEq(workflowId, i, "Should create escrow with sequential ID");
        }
    }
    
    // =========================================================================
    // Settings Validation Tests
    // =========================================================================
    
    function test_Security_rejectZeroAddressRecipient() public {
        // Zero address recipient is NOT allowed (contract validates this)
        vm.prank(sender);
        vm.expectRevert(); // Expects InvalidAddress error
        token.createEscrow(address(0), AMOUNT);
    }
    
    function test_Revert_Security_rejectInvalidTimeLimits() public {
        // Try to set invalid resolution module delay (below minimum 48 hours)
        vm.prank(owner);
        vm.expectRevert();
        token.setResolutionModuleDelay(1 hours);
    }
    
    // =========================================================================
    // Workflow ID Sequencing
    // =========================================================================
    
    function test_Security_workflowIdMonotonicallyIncreasing() public {
        uint256 id1 = token.nextWorkflowId();
        
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        
        uint256 id2 = token.nextWorkflowId();
        assertEq(id2, id1 + 1, "Workflow ID should increment");
        
        vm.prank(sender);
        token.createEscrow(recipient, AMOUNT);
        
        uint256 id3 = token.nextWorkflowId();
        assertEq(id3, id2 + 1, "Workflow ID should increment again");
    }
    
    function test_Security_workflowIdStartsAtZero() public {
        // Deploy fresh token
        EscrowableERC20 freshToken = new EscrowableERC20("Fresh", "FRH", ESCROW_FEE, feeRecipient, address(0), address(0));
        assertEq(freshToken.nextWorkflowId(), 0, "First workflow ID should be 0");
    }
}
