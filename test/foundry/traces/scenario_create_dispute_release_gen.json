{
  "schema_version": "1.0",
  "scenario_id": "create_dispute_release_gen",
  "seed": 42,
  "initial_block_time": 1000,
  "agents": [
    {"id": "buyer",    "type": "honest", "address": "0x0000000000000000000000000000000000001001"},
    {"id": "seller",   "type": "honest", "address": "0x0000000000000000000000000000000000001002"},
    {"id": "resolver", "type": "honest", "address": "0x0000000000000000000000000000000000001234"}
  ],
  "protocol_params": {
    "escrow_fee_bps": 100,
    "resolution_module": "0x0000000000000000000000000000000000001234"
  },
  "events": [
    {
      "seq": 0, "time": 1001, "agent": "buyer", "action": "create_escrow",
      "save_wf_as": "wf0",
      "params": {"token": "TOKEN", "to": "seller", "amount": 100000}
    },
    {
      "seq": 1, "time": 1002, "agent": "buyer", "action": "raise_dispute",
      "params": {"workflow_id": "wf0"}
    },
    {
      "seq": 2, "time": 3000, "agent": "resolver", "action": "execute_resolution",
      "params": {"workflow_id": "wf0", "is_release": true, "resolution_hash": "0xdeadbeef"}
    },
    {
      "seq": 3, "time": 200000, "agent": "buyer", "action": "execute_pending_settlement",
      "params": {"workflow_id": "wf0"}
    }
  ]
}
