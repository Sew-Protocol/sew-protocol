// SPDX-License-Identifier: UNLICENSED
pragma solidity 0.8.33;

import "forge-std/Test.sol";
import "../../../contracts/core/EscrowVault.sol";
import "../../../contracts/mocks/ERC20Mock.sol";
import "../../../contracts/core/modules/DefaultResolutionModule.sol";
import "../../../contracts/modules/DefaultReleaseStrategy.sol";
import "../../../contracts/types/EscrowTypes.sol";
import "../../../contracts/interfaces/IResolver.sol";

/**
 * @title Priority7_DisputeResolution
 * @notice Tests for dispute resolution correctness
 * @dev Priority #7: Verify dispute resolution works correctly
 */
contract Priority7_DisputeResolution is Test {
    EscrowVault public vault;
    ERC20Mock public token;
    DefaultResolutionModule public resolutionModule;
    DefaultReleaseStrategy public releaseStrategy;
    
    address public feeAddress;
    address public resolver;
    address public owner;
    
    uint256 public constant ESCROW_FEE = 100;
    
    function setUp() public {
        owner = address(this);
        feeAddress = address(0xFEE);
        resolver = address(0x1234);
        
        resolutionModule = new DefaultResolutionModule(owner, resolver);
        releaseStrategy = new DefaultReleaseStrategy();
        
        token = new ERC20Mock("Test Token", "TEST", owner, 10000000e18);
        vault = new EscrowVault(ESCROW_FEE, feeAddress, address(0), address(0));
        
        bytes32 ROLE_TIMELOCK = vault.ROLE_TIMELOCK();
        vault.grantRole(ROLE_TIMELOCK, owner);
        
        vault.queueDefaultResolutionModule(address(resolutionModule));
        vault.queueDefaultReleaseStrategy(address(releaseStrategy));
        
        vm.warp(block.timestamp + 7 days + 1);
        vault.activateDefaultResolutionModule();
        vault.activateDefaultReleaseStrategy();
    }
    
    /**
     * @notice Test: Raise dispute transitions to DISPUTED
     */
    function test_raiseDisputeTransitionsToDisputed() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Raise dispute
        vm.prank(buyer);
        vault.raiseDispute(workflowId);
        
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
        assertEq(uint256(et.escrowState), uint256(EscrowState.DISPUTED), "Should be DISPUTED");
    }
    
    /**
     * @notice Test: Only participants can raise dispute
     */
    function test_onlyParticipantsCanRaiseDispute() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        address attacker = address(0x3456789012345678901234567890123456789012);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Attacker attempts to raise dispute
        vm.prank(attacker);
        vm.expectRevert();
        vault.raiseDispute(workflowId);
    }
    
    /**
     * @notice Test: Dispute can only be raised in PENDING state
     */
    function test_disputeOnlyInPending() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Release escrow
        vm.prank(buyer);
        vault.releaseEscrowTransfer(workflowId);
        
        // Attempt to raise dispute on released escrow
        vm.prank(buyer);
        vm.expectRevert();
        vault.raiseDispute(workflowId);
    }
    
    /**
     * @notice Test: Resolver can resolve dispute
     */
    function test_resolverCanResolve() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Raise dispute
        vm.prank(buyer);
        vault.raiseDispute(workflowId);
        
        // Resolver releases
        vm.prank(resolver);
        vault.releaseAsDisputeResolver(workflowId);
        
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
        assertEq(uint256(et.escrowState), uint256(EscrowState.RESOLVED), "Should be RESOLVED");
        assertEq(et.remainingBalance, 0, "Balance should be zero");
    }
    
    /**
     * @notice Test: Payout validation (sum equals remaining balance)
     */
    function test_payoutValidation() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Raise dispute
        vm.prank(buyer);
        vault.raiseDispute(workflowId);
        
        // Get actual remaining balance (after fee deduction)
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
        uint256 remainingBalance = et.remainingBalance;
        
        // Attempt invalid payout (sum exceeds remaining balance)
        Payout[] memory payouts = new Payout[](1);
        payouts[0] = Payout({recipient: seller, amount: remainingBalance + 1}); // Exceeds balance
        
        vm.prank(resolver);
        vm.expectRevert();
         // vault.resolve(workflowId, payouts, bytes32(0));
    }
    
    /**
     * @notice Test: Multiple payouts work correctly
     */
    function test_multiplePayouts() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        address thirdParty = address(0x1003);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Raise dispute
        vm.prank(buyer);
        vault.raiseDispute(workflowId);
        
        // Get actual remaining balance (after fee deduction)
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
        uint256 remainingBalance = et.remainingBalance;
        
        // Resolve with multiple payouts (must sum to remainingBalance)
        Payout[] memory payouts = new Payout[](3);
        payouts[0] = Payout({recipient: seller, amount: remainingBalance * 60 / 100});
        payouts[1] = Payout({recipient: buyer, amount: remainingBalance * 30 / 100});
        payouts[2] = Payout({recipient: thirdParty, amount: remainingBalance - payouts[0].amount - payouts[1].amount});
        
        uint256 sellerBalanceBefore = token.balanceOf(seller);
        uint256 buyerBalanceBefore = token.balanceOf(buyer);
        uint256 thirdPartyBalanceBefore = token.balanceOf(thirdParty);
        
        vm.prank(resolver);
         // vault.resolve(workflowId, payouts, bytes32(0));
        
        assertEq(token.balanceOf(seller) - sellerBalanceBefore, payouts[0].amount, "Seller payout incorrect");
        assertEq(token.balanceOf(buyer) - buyerBalanceBefore, payouts[1].amount, "Buyer payout incorrect");
        assertEq(token.balanceOf(thirdParty) - thirdPartyBalanceBefore, payouts[2].amount, "Third party payout incorrect");
    }
    
    /**
     * @notice Test: Invalid payouts revert
     */
    function test_invalidPayoutsRevert() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Raise dispute
        vm.prank(buyer);
        vault.raiseDispute(workflowId);
        
        // Get actual remaining balance (after fee deduction)
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
        uint256 remainingBalance = et.remainingBalance;
        
        // Payout sum exceeds remaining balance
        Payout[] memory payouts = new Payout[](1);
        payouts[0] = Payout({recipient: seller, amount: remainingBalance + 1});
        
        vm.prank(resolver);
        vm.expectRevert();
         // vault.resolve(workflowId, payouts, bytes32(0));
    }
    
    /**
     * @notice Test: Resolver assignment works correctly
     */
    function test_resolverAssignment() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Raise dispute
        vm.prank(buyer);
        vault.raiseDispute(workflowId);
        
        EscrowTransfer memory et = vault.getEscrowTransfer(workflowId);
        assertEq(et.disputeResolver, resolver, "Resolver not assigned");
    }
    
    /**
     * @notice Test: Only authorized resolver can resolve
     */
    function test_onlyAuthorizedResolverCanResolve() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        address attacker = address(0x3456789012345678901234567890123456789012);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Raise dispute
        vm.prank(buyer);
        vault.raiseDispute(workflowId);
        
        // Attacker attempts to resolve
        vm.prank(attacker);
        vm.expectRevert();
        vault.releaseAsDisputeResolver(workflowId);
    }
}

