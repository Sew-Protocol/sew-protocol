// SPDX-License-Identifier: UNLICENSED
pragma solidity 0.8.33;

import "forge-std/Test.sol";
import "../../../contracts/core/EscrowVault.sol";
import "../../../contracts/mocks/ERC20Mock.sol";
import "../../../contracts/core/modules/DefaultResolutionModule.sol";
import "../../../contracts/modules/DefaultReleaseStrategy.sol";
import "../../../contracts/modules/AaveYieldGenerationModule.sol";
import "../../../contracts/mocks/MockAavePool.sol";
import "../../../contracts/types/EscrowTypes.sol";

/**
 * @title Priority10_EmergencyProcedures
 * @notice Tests for emergency procedures
 * @dev Priority #10: Verify emergency controls work correctly
 */
contract Priority10_EmergencyProcedures is Test {
    EscrowVault public vault;
    ERC20Mock public token;
    DefaultResolutionModule public resolutionModule;
    DefaultReleaseStrategy public releaseStrategy;
    AaveYieldGenerationModule public yieldModule;
    MockAavePool public aavePool;
    MockAToken public aToken;
    MockPoolAddressesProvider public poolProvider;
    
    address public feeAddress;
    address public resolver;
    address public owner;
    address public guardian;
    address public timelock;
    
    uint256 public constant ESCROW_FEE = 100;
    uint256 public constant TOKEN_CAP = 100000e18;
    uint256 public constant GLOBAL_CAP = 500000e18;
    
    function setUp() public {
        owner = address(this);
        feeAddress = address(0xFEE);
        resolver = address(0x1234);
        guardian = address(0x1234567890123456789012345678901234567890);
        timelock = address(0x2345678901234567890123456789012345678901);
        
        resolutionModule = new DefaultResolutionModule(owner, resolver);
        releaseStrategy = new DefaultReleaseStrategy();
        
        token = new ERC20Mock("Test Token", "TEST", owner, 10000000e18);
        vault = new EscrowVault(ESCROW_FEE, feeAddress, address(0), address(0));
        
        aavePool = new MockAavePool();
        aToken = new MockAToken(address(token), "aToken", "aTKN");
        aToken.setPool(address(aavePool));
        poolProvider = new MockPoolAddressesProvider(address(aavePool));
        yieldModule = new AaveYieldGenerationModule(owner);
        
        // Grant roles to yieldModule
        bytes32 YIELD_ROLE_TIMELOCK = yieldModule.ROLE_TIMELOCK();
        bytes32 YIELD_ROLE_GUARDIAN = yieldModule.ROLE_GUARDIAN();
        bytes32 YIELD_ROLE_ADMIN = yieldModule.DEFAULT_ADMIN_ROLE();
        yieldModule.grantRole(YIELD_ROLE_ADMIN, owner);
        yieldModule.grantRole(YIELD_ROLE_TIMELOCK, owner);
        
        // Configure Aave pool in yield module
        vm.prank(owner);
        yieldModule.queueAavePoolProvider(address(poolProvider));
        
        // Register token for Aave
        aavePool.setAToken(address(token), address(aToken));
        vm.prank(owner);
        yieldModule.registerTokenForAave(address(token), address(aToken));
        
        // Approve vault to spend tokens from aavePool
        vm.prank(address(vault));
        token.approve(address(aavePool), type(uint256).max);
        
        bytes32 ROLE_TIMELOCK = vault.ROLE_TIMELOCK();
        bytes32 ROLE_GUARDIAN = vault.ROLE_GUARDIAN();
        
        // Owner (deployer) has admin role by default, so can grant other roles
        // Grant ROLE_TIMELOCK to owner so it can queue/activate modules
        vault.grantRole(ROLE_TIMELOCK, owner);
        vault.grantRole(ROLE_TIMELOCK, timelock);
        vault.grantRole(ROLE_GUARDIAN, guardian);
        
        vm.prank(owner);
        vault.queueDefaultResolutionModule(address(resolutionModule));
        vm.prank(owner);
        vault.queueDefaultReleaseStrategy(address(releaseStrategy));
        vm.prank(owner);
        vault.queueDefaultYieldGenerationModule(address(yieldModule));
        
        // Warp forward enough time for all slow lane delays (queue + activate = ~14 days each, so ~28 days total)
        vm.warp(block.timestamp + 30 days);
        vm.prank(owner);
        yieldModule.activateAavePoolProvider();
        vm.prank(owner);
        vault.activateDefaultResolutionModule();
        vm.prank(owner);
        vault.activateDefaultReleaseStrategy();
        vm.prank(owner);
        vault.activateDefaultYieldGenerationModule();
        
        // Grant roles to yieldModule for timelock and guardian (using variables already declared above)
        yieldModule.grantRole(YIELD_ROLE_TIMELOCK, timelock);
        yieldModule.grantRole(YIELD_ROLE_GUARDIAN, guardian);
        
        // Set initial caps (on yieldModule, not vault)
        vm.prank(timelock);
        yieldModule.setTokenCap(address(token), TOKEN_CAP);
        vm.prank(timelock);
        yieldModule.setGlobalCap(address(token), GLOBAL_CAP);
    }
    
    /**
     * @notice Test: Guardian can pause protocol
     */
    function test_guardianCanPause() public {
        // Guardian pauses
        vm.prank(guardian);
        vault.pause();
        
        assertTrue(vault.paused(), "Not paused");
    }
    
    /**
     * @notice Test: Pause prevents new escrow creation
     */
    function test_pausePreventsNewEscrows() public {
        // Pause protocol
        vm.prank(guardian);
        vault.pause();
        
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        // Attempt to create escrow
        vm.prank(buyer);
        vm.expectRevert();
        vault.createEscrow(address(token), seller, amount);
    }
    
    /**
     * @notice Test: Pause prevents releases
     */
    function test_pausePreventsReleases() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        // Create escrow before pause
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Pause protocol
        vm.prank(guardian);
        vault.pause();
        
        // Attempt to release
        vm.prank(buyer);
        vm.expectRevert();
        vault.releaseEscrowTransfer(workflowId);
    }
    
    /**
     * @notice Test: Cancellations are allowed even when paused
     * @dev Note: Current implementation allows cancellations when paused.
     *      This may be intentional to allow users to exit during emergencies.
     */
    function test_cancellationsAllowedWhenPaused() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        // Create escrow before pause
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Pause protocol
        vm.prank(guardian);
        vault.pause();
        
        // Cancellation should still work (current behavior)
        vm.prank(buyer);
        bool success = vault.senderCancel(workflowId);
        assertTrue(success, "Cancellation should succeed even when paused");
    }
    
    /**
     * @notice Test: Guardian can disable Aave
     */
    function test_guardianCanDisableAave() public {
        // Guardian disables Aave
        vm.prank(guardian);
        yieldModule.guardianDisableAave();
        
        // Verify Aave disabled
        // Note: Implementation may vary
    }
    
    /**
     * @notice Test: Guardian can lower caps
     */
    function test_guardianCanLowerCaps() public {
        uint256 currentCap = yieldModule.tokenCap(address(token));
        
        // Guardian lowers cap
        vm.prank(guardian);
        yieldModule.guardianLowerTokenCap(address(token), currentCap - 1e18);
        
        assertEq(yieldModule.tokenCap(address(token)), currentCap - 1e18, "Cap not lowered");
    }
    
    /**
     * @notice Test: Unpause via timelock works
     */
    function test_unpauseViaTimelock() public {
        // Pause
        vm.prank(guardian);
        vault.pause();
        
        assertTrue(vault.paused(), "Not paused");
        
        // Unpause via timelock
        vm.prank(timelock);
        vault.unpause();
        
        assertFalse(vault.paused(), "Still paused");
    }
    
    /**
     * @notice Test: Re-enable Aave via timelock works
     */
    function test_reEnableAaveViaTimelock() public {
        // Disable Aave
        vm.prank(guardian);
        yieldModule.guardianDisableAave();
        
        // Re-enable via timelock
        vm.prank(timelock);
        yieldModule.setAaveEnabled(true);
        
        // Verify Aave enabled
        // Note: Implementation may vary
    }
    
    /**
     * @notice Test: Raise caps via timelock works
     */
    function test_raiseCapsViaTimelock() public {
        uint256 currentCap = yieldModule.tokenCap(address(token));
        
        // Raise cap via timelock
        vm.prank(timelock);
        yieldModule.setTokenCap(address(token), currentCap + 1e18);
        
        assertEq(yieldModule.tokenCap(address(token)), currentCap + 1e18, "Cap not raised");
    }
    
    /**
     * @notice Test: Full recovery flow
     */
    function test_fullRecoveryFlow() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 1000e18;
        
        // Create escrow
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, amount);
        
        // Emergency: Pause
        vm.prank(guardian);
        vault.pause();
        
        // Emergency: Disable Aave
        vm.prank(guardian);
        yieldModule.guardianDisableAave();
        
        // Emergency: Lower caps
        vm.prank(guardian);
        yieldModule.guardianLowerTokenCap(address(token), TOKEN_CAP / 2);
        
        // Recovery: Unpause
        vm.prank(timelock);
        vault.unpause();
        
        // Recovery: Re-enable Aave
        vm.prank(timelock);
        yieldModule.setAaveEnabled(true);
        
        // Recovery: Raise caps
        vm.prank(timelock);
        yieldModule.setTokenCap(address(token), TOKEN_CAP);
        
        // Verify protocol operational
        assertFalse(vault.paused(), "Still paused");
        
        // Can create new escrow
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        uint256 workflowId2 = vault.createEscrow(address(token), seller, amount);
        assertGt(workflowId2, 0, "Escrow creation failed after recovery");
    }
}

