// SPDX-License-Identifier: UNLICENSED
pragma solidity 0.8.33;

import "forge-std/Test.sol";
import "../../../contracts/core/EscrowVault.sol";
import "../../../contracts/mocks/ERC20Mock.sol";
import "../../../contracts/core/modules/DefaultResolutionModule.sol";
import "../../../contracts/modules/DefaultReleaseStrategy.sol";

/**
 * @title Priority8_FeeAccounting
 * @notice Tests for fee accounting accuracy
 * @dev Priority #8: Verify fee calculation and collection
 */
contract Priority8_FeeAccounting is Test {
    EscrowVault public vault;
    ERC20Mock public token;
    DefaultResolutionModule public resolutionModule;
    DefaultReleaseStrategy public releaseStrategy;
    
    address public feeAddress;
    address public resolver;
    address public owner;
    
    uint256 public constant ESCROW_FEE = 100; // 1%
    uint256 public constant FEE_DENOMINATOR = 10000;
    
    function setUp() public {
        owner = address(this);
        feeAddress = address(0xFEE);
        resolver = address(0x1234);
        
        resolutionModule = new DefaultResolutionModule(owner, resolver);
        releaseStrategy = new DefaultReleaseStrategy();
        
        token = new ERC20Mock("Test Token", "TEST", owner, 10000000e18);
        vault = new EscrowVault(ESCROW_FEE, feeAddress, address(0), address(0));
        
        bytes32 ROLE_TIMELOCK = vault.ROLE_TIMELOCK();
        vault.grantRole(ROLE_TIMELOCK, owner);
        
        vault.queueDefaultResolutionModule(address(resolutionModule));
        vault.queueDefaultReleaseStrategy(address(releaseStrategy));
        
        vm.warp(block.timestamp + 7 days + 1);
        vault.activateDefaultResolutionModule();
        vault.activateDefaultReleaseStrategy();
    }
    
    /**
     * @notice Test: Fee calculation uses correct denominator
     */
    function test_feeCalculationCorrectDenominator() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 10000e18; // 1% fee = 100e18
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        uint256 feeBefore = vault.totalFeesPerToken(address(token));
        
        vm.prank(buyer);
        vault.createEscrow(address(token), seller, amount);
        
        uint256 feeAfter = vault.totalFeesPerToken(address(token));
        uint256 expectedFee = (amount * ESCROW_FEE) / FEE_DENOMINATOR;
        
        assertEq(feeAfter - feeBefore, expectedFee, "Fee calculation incorrect");
    }
    
    /**
     * @notice Test: Fee calculation with different fee rates
     */
    function test_feeCalculationDifferentRates() public {
        // Test with different fee rates
        uint256[] memory feeRates = new uint256[](4);
        feeRates[0] = 50;   // 0.5%
        feeRates[1] = 100;  // 1%
        feeRates[2] = 250;  // 2.5%
        feeRates[3] = 500;  // 5%
        
        for (uint256 i = 0; i < feeRates.length; i++) {
            EscrowVault testVault = new EscrowVault(feeRates[i], feeAddress, address(0), address(0));
            bytes32 ROLE_TIMELOCK = testVault.ROLE_TIMELOCK();
            bytes32 ROLE_ADMIN = testVault.DEFAULT_ADMIN_ROLE();
            testVault.grantRole(ROLE_ADMIN, owner);
            testVault.grantRole(ROLE_TIMELOCK, owner);
            
            // Setup modules
            DefaultResolutionModule testResolutionModule = new DefaultResolutionModule(owner, resolver);
            DefaultReleaseStrategy testReleaseStrategy = new DefaultReleaseStrategy();
            
            testVault.queueDefaultResolutionModule(address(testResolutionModule));
            testVault.queueDefaultReleaseStrategy(address(testReleaseStrategy));
            
            // Get ETA from pending state and warp to that time + 1
            (, uint64 eta, ) = testVault.getPendingDefaultResolutionModule();
            if (eta > 0) {
                vm.warp(eta + 1);
            } else {
                // Fallback if ETA is 0
                unchecked {
                    vm.warp(block.timestamp + 7 days + 1);
                }
            }
            testVault.activateDefaultResolutionModule();
            testVault.activateDefaultReleaseStrategy();
            
            address buyer = address(uint160(0x1000 + i));
            address seller = address(uint160(0x2000 + i));
            uint256 amount = 10000e18;
            
            token.mint(buyer, amount);
            vm.prank(buyer);
            token.approve(address(testVault), amount);
            
            uint256 feeBefore = testVault.totalFeesPerToken(address(token));
            
            vm.prank(buyer);
            testVault.createEscrow(address(token), seller, amount);
            
            uint256 feeAfter = testVault.totalFeesPerToken(address(token));
            // Calculate expected fee
            uint256 expectedFee = (amount * feeRates[i]) / FEE_DENOMINATOR;
            
            // Calculate difference - feeAfter should always be >= feeBefore
            uint256 actualFee;
            unchecked {
                actualFee = feeAfter - feeBefore;
            }
            assertEq(actualFee, expectedFee, "Fee calculation incorrect");
        }
    }
    
    /**
     * @notice Test: Fee calculation edge cases
     */
    function test_feeCalculationEdgeCases() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        
        // Zero amount (should revert)
        token.mint(buyer, 0);
        vm.prank(buyer);
        token.approve(address(vault), 0);
        
        vm.prank(buyer);
        vm.expectRevert();
        vault.createEscrow(address(token), seller, 0);
        
        // Very small amount (must be > fee to succeed)
        // Fee is 1% (100/10000), so need at least 101 to have 1 left after fee
        uint256 smallAmount = 10000; // Large enough to cover fee and have remainder
        token.mint(buyer, smallAmount);
        vm.prank(buyer);
        token.approve(address(vault), smallAmount);
        
        vm.prank(buyer);
        uint256 workflowId = vault.createEscrow(address(token), seller, smallAmount);
        assertGe(workflowId, 0, "Small amount escrow failed");
        
        // Very large amount
        uint256 largeAmount = 1000000e18;
        token.mint(buyer, largeAmount);
        vm.prank(buyer);
        token.approve(address(vault), largeAmount);
        
        vm.prank(buyer);
        workflowId = vault.createEscrow(address(token), seller, largeAmount);
        assertGt(workflowId, 0, "Large amount escrow failed");
    }
    
    /**
     * @notice Test: Fees tracked per token
     */
    function test_feesTrackedPerToken() public {
        ERC20Mock token2 = new ERC20Mock("Token2", "TKN2", owner, 10000000e18);
        
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 10000e18;
        
        // Create escrow with token
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        vault.createEscrow(address(token), seller, amount);
        
        // Create escrow with token2
        token2.mint(buyer, amount);
        vm.prank(buyer);
        token2.approve(address(vault), amount);
        
        vm.prank(buyer);
        vault.createEscrow(address(token2), seller, amount);
        
        // Verify fees tracked separately
        uint256 fee1 = vault.totalFeesPerToken(address(token));
        uint256 fee2 = vault.totalFeesPerToken(address(token2));
        
        assertEq(fee1, (amount * ESCROW_FEE) / FEE_DENOMINATOR, "Token1 fee incorrect");
        assertEq(fee2, (amount * ESCROW_FEE) / FEE_DENOMINATOR, "Token2 fee incorrect");
    }
    
    /**
     * @notice Test: Fee withdrawal works correctly
     */
    function test_feeWithdrawal() public {
        address buyer = address(0x1001);
        address seller = address(0x1002);
        uint256 amount = 10000e18;
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        vm.prank(buyer);
        vault.createEscrow(address(token), seller, amount);
        
        uint256 feesAccumulated = vault.totalFeesPerToken(address(token));
        uint256 feeAddressBalanceBefore = token.balanceOf(feeAddress);
        
        // Withdraw fees (must be called by feeAddress)
        vm.prank(feeAddress);
        vault.withdrawFees(address(token));
        
        uint256 feeAddressBalanceAfter = token.balanceOf(feeAddress);
        assertEq(feeAddressBalanceAfter - feeAddressBalanceBefore, feesAccumulated, "Fee withdrawal incorrect");
    }
    
    /**
     * @notice Fuzz test: Fee calculation for various amounts
     */
    function testFuzz_feeCalculation(uint256 amount) public {
        amount = bound(amount, 1, 1000000e18);
        
        address buyer = address(0x1001);
        address seller = address(0x1002);
        
        token.mint(buyer, amount);
        vm.prank(buyer);
        token.approve(address(vault), amount);
        
        uint256 feeBefore = vault.totalFeesPerToken(address(token));
        
        vm.prank(buyer);
        vault.createEscrow(address(token), seller, amount);
        
        uint256 feeAfter = vault.totalFeesPerToken(address(token));
        uint256 expectedFee = (amount * ESCROW_FEE) / FEE_DENOMINATOR;
        
        assertEq(feeAfter - feeBefore, expectedFee, "Fee calculation incorrect");
    }
}

