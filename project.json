{
  "name": "hardhat-deploy-hybrid",
  "version": "0.1.0",
  "description": "Classic hardhat-deploy scaffold (not Ignition) with robust deployment ledger, upgradeable deployments (Transparent or UUPS), Hardhat tests + Foundry tests.",
  "based_on": "https://github.com/wighawag/hardhat-deploy",
  "stack": {
    "deployment": ["hardhat-deploy (classic)"],
    "upgrades": ["openzeppelin contracts-upgradeable", "openzeppelin hardhat-upgrades (helper)"],
    "testing": ["hardhat (ts) tests", "foundry tests (forge)"],
    "verification": ["@nomicfoundation/hardhat-verify"],
    "ci": ["github actions"]
  },
  "layout": {
    "solidity": "contracts/",
    "hardhat_tests": "test/hardhat/",
    "foundry_tests": "test/foundry/",
    "deploy_scripts": "deploy/",
    "deployments": "deployments/",
    "ledger_bundles": "deploy-ledger/",
    "scripts": "scripts/"
  },
  "commands": {
    "install": "pnpm i",
    "test": "pnpm test",
    "deploy_local": "pnpm deploy:local",
    "deploy_transparent": "PROXY_KIND=transparent pnpm deploy --network <name>",
    "deploy_uups": "PROXY_KIND=uups pnpm deploy --network <name>",
    "export_ledger": "pnpm export --network <name>"
  },
  "generated_at_utc": "2025-12-31T19:18:38.275442Z"
}
