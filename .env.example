# Hardhat Deploy Hybrid - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# Network Configuration
# =============================================================================

# Private key for deployment (DO NOT use mainnet key in development)
PRIVATE_KEY=your_private_key_here

# Deployment confirmation (required for mainnet deployments)
# Set to "YES" to allow mainnet-like deployments
DEPLOY_CONFIRM=NO

# RPC URLs for networks
RPC_BASE_SEPOLIA=https://sepolia.base.org
RPC_BASE_MAINNET=https://mainnet.base.org
RPC_ETHEREUM=https://eth.llamarpc.com

# Block Explorer API Keys (for contract verification)
BASESCAN_API_KEY=your_basescan_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# =============================================================================
# Governance Configuration
# =============================================================================

# Governance Token Configuration
GOVERNANCE_TOKEN_NAME=Sew Token
GOVERNANCE_TOKEN_SYMBOL=SEW
GOVERNANCE_TOKEN_SUPPLY=1000000000000000000000000000

# Safe Multisig Configuration
# Add Safe owner addresses (at least SAFE_THRESHOLD owners required)
SAFE_OWNER_1=0x0000000000000000000000000000000000000000
SAFE_OWNER_2=0x0000000000000000000000000000000000000000
SAFE_OWNER_3=0x0000000000000000000000000000000000000000
SAFE_OWNER_4=0x0000000000000000000000000000000000000000
SAFE_OWNER_5=0x0000000000000000000000000000000000000000
SAFE_THRESHOLD=3

# Timelock Configuration
TIMELOCK_DELAY=172800
# 172800 seconds = 48 hours

# Governor Configuration
VOTING_DELAY=1
# Voting delay in blocks (1 block default)

VOTING_PERIOD=45818
# Voting period in blocks (~1 week @ 13s/block)

PROPOSAL_THRESHOLD=50000000000000000000000
# Proposal threshold in token units (100k tokens default)

QUORUM_BPS=400
# Quorum in basis points (400 = 4%)

# Guardian and Fee Configuration
GUARDIAN_MULTISIG=0x0000000000000000000000000000000000000000
FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# Initial Governance Token Mints (for testing)
# Format: "address1:amount1,address2:amount2"
# Example: "0x123...:1000000000000000000000,0x456...:2000000000000000000000"
GOV_MINTS=

# =============================================================================
# Governance Scripts Configuration
# =============================================================================

# Guardian address (for emergency scripts)
GUARDIAN_ADDRESS=0x0000000000000000000000000000000000000000

# Timelock address (for governance simulation)
TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# Governance Payload Configuration
# =============================================================================

# For governance payload scripts (e.g., 0002_queue_fee_address.ts)
NEW_FEE_ADDRESS=0x0000000000000000000000000000000000000000
NEW_RESOLUTION_MODULE=0x0000000000000000000000000000000000000000
TARGET_CONTRACT=EscrowableERC20
# Options: "EscrowableERC20" or "EscrowVault"

# =============================================================================
# Proxy Configuration
# =============================================================================

# Proxy kind for upgradeable contracts
# Options: "transparent" or "uups"
PROXY_KIND=transparent

# =============================================================================
# Base Sepolia Core Testnet Deployment
# =============================================================================

# Deployer key for baseSepolia (used for ops/core/module wiring). If unset,
# PRIVATE_KEY is used for the baseSepolia network as well.
SEPOLIA_DEPLOY_KEY=your_base_sepolia_deploy_key_here

# CREATE2EscrowFactory is skipped on testnet due to contract size unless opted in.
# Set to "true" to deploy it (only on networks where the size constraint does not apply).
DEPLOY_CREATE2_FACTORY=false

# EscrowableERC20 deployment is optional. Set to "true" to deploy it during
# deploy/70; otherwise only EscrowVault is deployed.
DEPLOY_ESCROWABLE_ERC20=false
# Name/symbol for the optional EscrowableERC20 token.
ESCROWABLE_TOKEN_NAME=Escrowable Token
ESCROWABLE_TOKEN_SYMBOL=ESCROW

# Escrow fee in basis points (0-10000) applied at escrow creation. 0 = no fee.
ESCROW_FEE_BPS=0

# Optional EIP-1559 priority-Fee/Max-Fee overrides (gwei) for retrying
# "replacement transaction underpriced" / stuck-nonce errors on testnets.
TX_MAX_FEE_GWEI=
TX_PRIORITY_FEE_GWEI=
TX_GAS_PRICE_GWEI=
