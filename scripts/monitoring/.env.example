# ===== Blockchain RPC Configuration =====
# Mainnet RPC endpoint
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# ===== Contract Addresses =====
# BaseEscrow (EscrowVault) contract address
ESCROW_VAULT_ADDRESS=0x...

# Guardian account address (for reference)
GUARDIAN_ADDRESS=0x...

# ===== Alert Channels =====

# Slack webhook URL for alerts
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Discord webhook URL for alerts
# Get from: Server Settings > Webhooks > Create Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# PagerDuty integration key for escalations
# Get from: Integrations > Events API V2
PAGERDUTY_INTEGRATION_KEY=YOUR_PAGERDUTY_KEY

# Email address for audit trail and notifications
ALERT_EMAIL=ops@example.com

# ===== Environment Configuration =====
# Set to 'production' for daemonized monitoring, 'development' for verbose output
NODE_ENV=development

# Starting block number for monitoring (optional, defaults to current)
# Use this to scan historical events when first deploying monitor
# START_BLOCK=18000000

# ===== Monitoring Settings =====
# Poll interval in milliseconds (default: 12000 = 12 seconds)
# Poll more frequently for faster alerts, less frequently to reduce RPC load
POLL_INTERVAL=12000
