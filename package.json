{
  "name": "hardhat-deploy-hybrid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "pnpm test:hardhat && pnpm test:foundry",
    "test:hardhat": "hardhat test",
    "test:foundry": "forge test -vvv",
    "compile": "hardhat compile && forge build",
    "deploy": "hardhat deploy",
    "deploy:local": "hardhat deploy --network hardhat",
    "export": "hardhat run scripts/export-ledger.ts",
    "verify": "hardhat run scripts/verify.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier -w .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gov:build": "ts-node scripts/gov/build-proposal.ts",
    "gov:sim": "ts-node scripts/gov/simulate-hardhat.ts",
    "gov:stage": "ts-node scripts/gov/stage.ts",
    "gov:check": "ts-node scripts/gov/check.ts",
    "gov:emergency": "ts-node scripts/gov/emergency.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/node": "^20.19.27",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "hardhat": "^2.28.2",
    "hardhat-deploy": "0.12.0",
    "hardhat-deploy-ethers": "^0.4.2",
    "hardhat-network-helpers^1.1.2": "link:@nomicfoundation/hardhat-network-helpers^1.1.2",
    "prettier": "^3.7.4",
    "prettier-plugin-solidity": "^1.4.3",
    "typechain": "^8.3.0",
    "typescript": "^5.9.3"
  }
}
