{
  "name": "hardhat-deploy-hybrid",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "pnpm test:hardhat && pnpm test:foundry",
    "test:hardhat": "hardhat test",
    "test:foundry": "forge test -vvv",
    "test:foundry:core": "forge test --match-path 'test/foundry/core/*.t.sol' --no-match-path '*disabled*' -vvv",
    "test:foundry:modules": "forge test test/foundry/core/ModuleMetadataSimple.t.sol test/foundry/decentralized-resolution-module -vvv",
    "test:foundry:release-resolution": "bash scripts/test-core-modules.sh",
    "coverage": "forge coverage --report lcov --ir-minimum || true && node scripts/filter-coverage.js",
    "coverage:summary": "bash scripts/coverage-summary.sh",
    "coverage:report": "bash scripts/coverage-summary.sh > report 2>&1 || true",
    "compile": "hardhat compile && forge build",
    "deploy": "hardhat deploy",
    "deploy:local": "hardhat deploy --network hardhat",
    "export": "hardhat run scripts/export-ledger.ts",
    "verify": "hardhat run scripts/verify.ts",
    "lint": "eslint . --max-warnings 0 --ignore-pattern \"typechain-types/**\" --ignore-pattern \"out/**\" --ignore-pattern \"cache/**\" --ignore-pattern \"cache-foundry/**\" --ignore-pattern \"artifacts/**\" --ignore-pattern \"deployments/**\" --ignore-pattern \"deploy-ledger/**\" --ignore-pattern \"coverage/**\"",
    "format": "prettier -w .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gov:build": "ts-node scripts/gov/build-proposal.ts",
    "gov:sim": "ts-node scripts/gov/simulate-hardhat.ts",
    "gov:stage": "ts-node scripts/gov/stage.ts",
    "gov:check": "ts-node scripts/gov/check.ts",
    "gov:emergency": "ts-node scripts/gov/emergency.ts",
    "gov:surface:check": "ts-node scripts/gov/check-surface.ts",
    "size": "ts-node scripts/print-contract-sizes.ts",
    "size:check": "hardhat compile && ts-node scripts/print-contract-sizes.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@safe-global/safe-contracts": "1.4.1-2",
    "@typechain/hardhat": "^9.1.0",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.2",
    "hardhat-deploy": "0.12.0",
    "hardhat-deploy-ethers": "^0.4.2",
    "prettier": "^3.7.4",
    "prettier-plugin-solidity": "^1.4.3",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google/gemini-cli": "^0.26.0"
  }
}
